{
  "framework": null,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/gpt-modelo-ia",
      "destination": "/gpt-modelo-ia/index.html"
    },
    {
      "source": "/agente-ai-gpt",
      "destination": "/agente-ai-gpt/index.html"
    }
  ],
  "headers": [
    {
      "source": "/gpt-modelo-ia/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
