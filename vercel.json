{
  "framework": null,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/gpt-modelo-ia",
      "destination": "/gpt-modelo-ia/index.html"
    },
    {
      "source": "/agente-ai-gpt",
      "destination": "/agente-ai-gpt/index.html"
    },
    {
      "source": "/app-web-codex",
      "destination": "/app-web-codex/index.html"
    },
    {
      "source": "/pequenos-negocios",
      "destination": "/pequenos-negocios/index.html"
    },
    {
      "source": "/pequenos-negocios-obrigado",
      "destination": "/pequenos-negocios-obrigado/index.html"
    },
    {
      "source": "/gpt-contabilidade",
      "destination": "/gpt-contabilidade/index.html"
    },
    {
      "source": "/gpt-contabilidade-obrigado",
      "destination": "/gpt-contabilidade-obrigado/index.html"
    },
    {
      "source": "/profissional-ia",
      "destination": "/profissional-ia/index.html"
    }
  ],
  "headers": [
    {
      "source": "/gpt-modelo-ia/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
